      "function HomeScreen({ navigation }) {",
      "  return (",
      "    <Button ",
      "      title=\"Ir a Perfil\"",
      "      onPress={() => navigation.navigate('Profile', { ",
      "        userId: 123, ",
      "        name: 'Juan' ",
      "      })}",
      "    />",
      "  );",
      "}",
      "",
      "// Pantalla que RECIBE (ProfileScreen)",
